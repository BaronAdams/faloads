{
  "name": "StructCalc - Flutter Web",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "flutter doctor -v && flutter create --platforms=web . && flutter pub get",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "StructCalc Web",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  }
}
