{
  "name": "calisigma",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "prepare:ec2": "node tools/prepare-ec2.mjs",
    "predev": "npm run prepare:ec2",
    "prebuild": "npm run prepare:ec2",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "tauri": "tauri",
    "android:init": "tauri android init --ci --skip-targets-install && node tools/configure-android.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc -b",
    "icons": "tauri icon tools/app-icon.json",
    "test:ec2": "python3 -m unittest discover -s tests/ec2 -p test_engine.py && python3 tests/ec2/column_reference.py && python3 tests/ec2/flexion_reference.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "mathjax-full": "^3.2.2",
    "next-themes": "^0.4.6",
    "pdfmake": "^0.2.23",
    "pyodide": "0.27.7",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "^0.2.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
